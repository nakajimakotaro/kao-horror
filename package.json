    "assets": "node tools/build-assets.mjs",
    "validate": "node tools/validate.mjs",
    "build:artifact": "tsc -p . && node tools/build-artifact.mjs",
    "upload": "node tools/upload-itch.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
