{
  "name": "kao-horror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "深夜3時、顔を見つめてはいけない。一人称3Dホラー（WebGL / three.js）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
